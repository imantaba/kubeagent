  "$id": "https://k8sproject.top/schemas/scan-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The document written by `kubeagent scan --output json`: the cluster verdict, the prioritized workload inventory, and the findings of every check the run enabled.",
  "properties": {
    "blindSpots": {
      "items": {
        "$ref": "#/$defs/scan.ReadFailure"
      },
      "type": "array"
    },
    "capacity": {
      "$ref": "#/$defs/capacity.Report"
    },
    "certificates": {
      "$ref": "#/$defs/certhealth.Report"
    },
    "cluster": {
      "$ref": "#/$defs/clusterhealth.ClusterHealth"
    },
    "controlPlane": {
      "$ref": "#/$defs/controlplane.Probe"
    },
    "credentialWarnings": {
      "items": {
        "$ref": "#/$defs/credlint.Finding"
      },
      "type": "array"
    },
    "diskUsage": {
      "$ref": "#/$defs/diskusage.Report"
    },
    "dns": {
      "$ref": "#/$defs/dnshealth.Report"
    },
    "explanation": {
      "type": "string"
    },
    "gitops": {
      "$ref": "#/$defs/gitops.Report"
    },
    "hpaIssues": {
      "items": {
        "$ref": "#/$defs/hpahealth.Issue"
      },
      "type": "array"
    },
    "ingressIssues": {
      "items": {
        "$ref": "#/$defs/ingresshealth.RouteIssue"
      },
      "type": "array"
    },
    "investigation": {
      "$ref": "#/$defs/report.InvestigationView"
    },
    "kubeletHealth": {
      "$ref": "#/$defs/nodehealth.Report"
    },
    "nodeReserve": {
      "$ref": "#/$defs/nodereserve.Report"
    },
    "operators": {
      "$ref": "#/$defs/operators.Report"
    },
    "pdbIssues": {
      "items": {
        "$ref": "#/$defs/pdbhealth.Issue"
      },
      "type": "array"
    },
    "platform": {
      "$ref": "#/$defs/platform.Facts"
    },
    "policy": {
      "$ref": "#/$defs/report.PolicyView"
    },
    "pvcIssues": {
      "items": {
        "$ref": "#/$defs/pvchealth.Issue"
      },
      "type": "array"
    },
    "pvcReclaim": {
      "$ref": "#/$defs/pvcreclaim.Report"
    },
    "quotaIssues": {
      "items": {
        "$ref": "#/$defs/quotahealth.Issue"
      },
      "type": "array"
    },
    "remediationPlan": {
      "items": {
        "$ref": "#/$defs/report.RemediationActionView"
      },
      "type": "array"
    },
    "resources": {
      "$ref": "#/$defs/resources.Summary"
    },
    "schemaVersion": {
      "description": "This document's schema version, MAJOR.MINOR. Treat an unknown MINOR as compatible.",
      "pattern": "^1\\.[0-9]+$",
      "type": "string"
    },
    "securityIssues": {
      "items": {
        "$ref": "#/$defs/secscan.Finding"
      },
      "type": "array"
    },
    "serviceIssues": {
      "items": {
        "$ref": "#/$defs/svchealth.Issue"
      },
      "type": "array"
    },
    "stuckTerminating": {
      "items": {
        "$ref": "#/$defs/termhealth.Issue"
      },
      "type": "array"
    },
    "webhookIssues": {
      "items": {
        "$ref": "#/$defs/webhookhealth.Issue"
      },
      "type": "array"
    },
    "workloads": {
      "items": {
        "$ref": "#/$defs/inventory.Workload"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "cluster",
    "schemaVersion",
    "workloads"
  ],
  "title": "kubeagent scan report",
  "type": "object"
}
